{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "9369622208955120331"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Defaults to the resource group location."
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "vnet-az104-project04",
      "metadata": {
        "description": "Name of the virtual network."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Environment": "Lab",
        "CostCenter": "IT-Services",
        "Owner": "Harold Nduna",
        "Project": "AZ104-Project04"
      },
      "metadata": {
        "description": "Tags applied to every resource."
      }
    }
  },
  "variables": {
    "webPrefix": "10.10.1.0/24",
    "appPrefix": "10.10.2.0/24",
    "dataPrefix": "10.10.3.0/24",
    "bastionPrefix": "10.10.254.0/26",
    "mgmtFromBastion": {
      "priority": 110,
      "direction": "Inbound",
      "access": "Allow",
      "protocol": "Tcp",
      "sourceAddressPrefix": "[variables('bastionPrefix')]",
      "sourcePortRange": "*",
      "destinationPortRanges": [
        "22",
        "3389"
      ],
      "description": "Admin access only from the Bastion (jump-box) subnet"
    },
    "denyVnetInbound": {
      "priority": 4000,
      "direction": "Inbound",
      "access": "Deny",
      "protocol": "*",
      "sourceAddressPrefix": "VirtualNetwork",
      "sourcePortRange": "*",
      "destinationAddressPrefix": "*",
      "destinationPortRange": "*",
      "description": "Overrides default AllowVnetInBound (65000) - blocks lateral movement"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "nsg-web",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-HTTPS-Internet",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "Internet",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "[variables('webPrefix')]",
              "destinationPortRange": "443",
              "description": "Public HTTPS to the web tier only"
            }
          },
          {
            "name": "Allow-Mgmt-Bastion",
            "properties": "[union(variables('mgmtFromBastion'), createObject('destinationAddressPrefix', variables('webPrefix')))]"
          },
          {
            "name": "Deny-VNet-Inbound",
            "properties": "[variables('denyVnetInbound')]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "nsg-app",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-App-From-Web",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[variables('webPrefix')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "[variables('appPrefix')]",
              "destinationPortRange": "8080",
              "description": "Only the web tier may call the app tier"
            }
          },
          {
            "name": "Allow-Mgmt-Bastion",
            "properties": "[union(variables('mgmtFromBastion'), createObject('destinationAddressPrefix', variables('appPrefix')))]"
          },
          {
            "name": "Deny-VNet-Inbound",
            "properties": "[variables('denyVnetInbound')]"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2024-05-01",
      "name": "nsg-data",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-SQL-From-App",
            "properties": {
              "priority": 100,
              "direction": "Inbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[variables('appPrefix')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "[variables('dataPrefix')]",
              "destinationPortRange": "1433",
              "description": "Only the app tier may reach the database port"
            }
          },
          {
            "name": "Allow-Mgmt-Bastion",
            "properties": "[union(variables('mgmtFromBastion'), createObject('destinationAddressPrefix', variables('dataPrefix')))]"
          },
          {
            "name": "Deny-VNet-Inbound",
            "properties": "[variables('denyVnetInbound')]"
          },
          {
            "name": "Allow-Storage-Out",
            "properties": {
              "priority": 100,
              "direction": "Outbound",
              "access": "Allow",
              "protocol": "Tcp",
              "sourceAddressPrefix": "[variables('dataPrefix')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "Storage",
              "destinationPortRange": "443",
              "description": "Data tier may reach Azure Storage (service tag) over HTTPS"
            }
          },
          {
            "name": "Deny-Internet-Out",
            "properties": {
              "priority": 4000,
              "direction": "Outbound",
              "access": "Deny",
              "protocol": "*",
              "sourceAddressPrefix": "[variables('dataPrefix')]",
              "sourcePortRange": "*",
              "destinationAddressPrefix": "Internet",
              "destinationPortRange": "*",
              "description": "Overrides default AllowInternetOutBound - prevents data exfiltration"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2024-05-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "10.10.0.0/16"
          ]
        },
        "subnets": [
          {
            "name": "snet-web",
            "properties": {
              "addressPrefix": "[variables('webPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-web')]"
              },
              "defaultOutboundAccess": false
            }
          },
          {
            "name": "snet-app",
            "properties": {
              "addressPrefix": "[variables('appPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-app')]"
              },
              "defaultOutboundAccess": false
            }
          },
          {
            "name": "snet-data",
            "properties": {
              "addressPrefix": "[variables('dataPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-data')]"
              },
              "serviceEndpoints": [
                {
                  "service": "Microsoft.Storage"
                }
              ],
              "defaultOutboundAccess": false
            }
          },
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "[variables('bastionPrefix')]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-app')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-data')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-web')]"
      ]
    }
  ],
  "outputs": {
    "vnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
    },
    "nsgIds": {
      "type": "array",
      "value": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-web')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-app')]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', 'nsg-data')]"
      ]
    }
  }
}